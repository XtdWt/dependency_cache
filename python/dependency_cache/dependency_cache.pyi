from typing import Any, final

from _typeshed import SupportsGetItem
from typing_extensions import disjoint_base

@disjoint_base
class DependencyCacheBase:
    def __new__(cls, /, *_args, **_kwargs) -> DependencyCacheBase: ...
    @property
    def cached_values(self, /) -> dict: ...
    def clear_cache(self, /) -> None: ...
    def clear_cached_value(self, /, method_name: str, **kwargs) -> None: ...
    @property
    def dependency_graph(self, /) -> dict: ...
    def dump_cache(self, /, order: SupportsGetItem[int, str] | None = None) -> dict: ...
    def get_cached_value(
        self, /, method_name: str, strict: bool = True, **kwargs
    ) -> Any | None: ...
    def is_cached(self, /, method_name: str, **kwargs) -> bool: ...
    def load_cache(
        self, /, data: dict, order: SupportsGetItem[int, str] | None = None
    ) -> None: ...
    def update_cached_value(
        self, /, method_name: str, value: Any, must_contain: bool = True, **kwargs
    ) -> None: ...
    @property
    def validation_state(self, /) -> dict: ...

@final
class Scenario:
    def __new__(cls, /, objects: SupportsGetItem[int, Any]) -> Scenario: ...
    def collect(self, /, parallel: bool = True) -> list[Any]: ...
    def filter(self, /, predicate: Any) -> Scenario: ...
    def map(self, /, func: Any) -> Scenario: ...

@final
class automagically_dependency_cached:
    def __call__(self, /, func: Any) -> Any: ...
    def __new__(
        cls,
        /,
        use_cache: bool = True,
        dependencies: Any | None = None,
        track_runtime_dependencies: bool = False,
        serialisable: bool = False,
    ) -> automagically_dependency_cached: ...

@final
class dependency_cached:
    def __call__(self, /, func: Any) -> Any: ...
    def __new__(
        cls,
        /,
        use_cache: bool = True,
        dependencies: Any | None = None,
        track_runtime_dependencies: bool = False,
        serialisable: bool = False,
    ) -> dependency_cached: ...

def temporary_override(objects: SupportsGetItem[int, Any]) -> Any: ...
