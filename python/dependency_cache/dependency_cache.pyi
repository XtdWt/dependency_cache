from collections.abc import Sequence
from typing import Any, final

class DependencyCacheBase:
    def __init__(self, /, *_args, **_kwargs) -> None: ...
    def __new__(cls, /, *_args, **_kwargs) -> DependencyCacheBase: ...
    def clear_cache(self, /) -> None: ...
    def get_cached_value(self, /, name: str) -> Any | None: ...
    def get_cached_values(self, /) -> dict: ...
    def get_dependency_graph(self, /) -> dict: ...
    def get_validation_state(self, /) -> dict: ...
    def update_cached_value(self, /, name: str, value: Any) -> None: ...

@final
class dependency_cached:
    def __call__(self, /, func: Any) -> Any: ...
    def __new__(cls, /, use_cache: bool = True, dependencies: Sequence[str] = ...) -> dependency_cached: ...
